# BioWriter Studio & Governed Research Agent — Environment Configuration

# Flask Session Secret Key (MANDATORY in Production)
# In production, startup will fail if SECRET_KEY is missing, empty, shorter than 32 characters,
# or set to a known insecure placeholder (regardless of case).
# Production keys MUST be cryptographically secure random strings (minimum 32 characters / 256 bits).
# Generate a cryptographically secure random key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Example production key (64 hex characters):
# SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Environment Mode:
# Set to 'development' ONLY for local development without a production SECRET_KEY.
# BIOWRITER_ENV=development

# Faculty administrative passcode
FACULTY_PASSCODE=BT301-FACULTY-2026

# Server port (default: 5000)
PORT=5000
